# Copy to .env.local. Keep secrets local and never commit that file.
DATABASE_URL=postgresql://sera_app@127.0.0.1:5432/smart_emergency_response
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=emergency_ops
# SESSION_SECRET is currently unused by the application; sessions use random tokens
# stored as SHA-256 hashes in PostgreSQL. It is included per the local setup contract.
SESSION_SECRET=YOUR_SECRET
NODE_ENV=development
# Required only when running the one-time synthetic administrator seed.
BOOTSTRAP_ADMIN_USERNAME=sera-admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# Set this privately in your local .env.local; use at least 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
